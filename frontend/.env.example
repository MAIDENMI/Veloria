# API Keys Template
# Copy this file to .env.local and fill in your actual keys

# OpenAI API Key
OPENAI_API_KEY=your_openai_key_here

# Google/Gemini API Key (for TTS and other services)
GOOGLE_API_KEY=your_google_key_here

# ElevenLabs Configuration (Required for voice chat)
NEXT_PUBLIC_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# Google TTS (Alternative to ElevenLabs)
NEXT_PUBLIC_GOOGLE_TTS_API_KEY=your_google_tts_key_here

# Next.js public keys (accessible in browser)
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_key_here
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_key_here


To access your new D1 Database in your Worker, add the following snippet to your configuration file:
[[d1_databases]]
binding = "eunoia_db"
database_name = "eunoia-db"
database_id = "753797e7-9b59-44fa-8ce2-f5fb711cf251"